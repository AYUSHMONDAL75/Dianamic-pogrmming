#include<stdio.h>
#define max 100
int main(){
    int n,dp[max];
    printf("Enter vallue of n: ");
    scanf("%d",&n);
    dp[0]=0;
    dp[1]=1;
    for(int i=2;i<=n;i++){
        dp[i]=dp[i-1]+dp[i-2];
    }
    printf("Fibonacci series: ");
    for(int i=0;i<n;i++){
        printf("%d ",dp[i]);
    }
    return 0;
}
