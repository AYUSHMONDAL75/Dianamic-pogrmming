#include<stdio.h>
#define MAX 1000 
int arr[MAX], dp[MAX][MAX], n;
int matrix_chain(){
    int l, i, j, k, cost;
    for(i = 1; i <= n; i++){
        dp[i][i] = 0;
    }for(l = 2; l <= n; l++){
        for(i = l; i <= n-l+1; i++){
            j = i + l - 1;
            dp[i][j] = 999999;
            for(k = i; k < j; k++){
                cost = dp[i][k]+ dp[k+1][j]+ arr[i-1] * arr[k] * arr[j];
                if(cost < dp[i][j]){
                    dp[i][j] = cost;
                }
            }
        }
    }
    return dp[1][n];
}
int main(){
    printf("Enter number of matrices: ");
    scanf("%d", &n);
    printf("Enter %d dimensions: ", n+1);
    for(int i = 0; i <= n; i++){
        scanf("%d", &arr[i]);
    }
    printf("Minimum multiplication cost = %d", matrix_chain());
    return 0;
}
