#include<stdio.h>
int n,r;
int bionomial(){
    int dp[n+1][r+1];
    for(int i=0;i<=n;i++){
        for(int j=0;j<=r;j++){
            if(j==0 || j==i){
                dp[i][j]=1;
            }else if(j<i){
                dp[i][j]=dp[i-1][j-1]+dp[i-1][j];
            }
        }
    }
    return dp[n][r];
}
int main(){
    printf("Enter value of n: ");
    scanf("%d",&n);
    printf("Enter value of r: ");
    scanf("%d",&r);
    printf("Bionomial coefficient c(%d,%d): %d",n,r,bionomial());
    return 0;
}
